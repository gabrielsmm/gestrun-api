# Desenvolvimento local
DATABASE_URL=jdbc:postgresql://localhost:5432/gestrun
DATABASE_NAME=gestrun
DATABASE_USERNAME=altere_este_usuario
DATABASE_PASSWORD=altere_esta_senha

# Gere um valor Base64 aleatório com pelo menos 32 bytes antes de usar.
JWT_SECRET=altere_por_um_segredo_base64_forte
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Usadas apenas com o perfil bootstrap-admin.
BOOTSTRAP_ADMIN_NOME=Administrador GestRun
BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.com
BOOTSTRAP_ADMIN_SENHA=altere_por_uma_senha_forte
